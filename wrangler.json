{
  "compatibility_date": "2025-10-08",
  "main": "src/server/index.ts",
  "name": "remote-device-cloud",
  "migrations": [
    {
      "new_sqlite_classes": [
        "Chat"
      ],
      "tag": "v1"
    },
    {
      "new_classes": [
        "RemoteRoom"
      ],
      "tag": "v2"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RemoteRoom",
        "name": "RemoteRoom"
      },
      {
        "class_name": "Chat",
        "name": "Chat"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
