<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لوحة التحكم"
            android:textColor="#90CAF9"
            android:textSize="16sp"
            android:layout_marginBottom="40dp"/>

        <!-- ================================================= -->
        <!-- قسم تسجيل الدخول -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/loginSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 تسجيل الدخول"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/loginDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اسم الجهاز (مثلاً: موبايلي)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#4CAF50"
                android:inputType="text"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/loginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="الباسورد"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#4CAF50"
                android:inputType="textPassword"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="دخول"
                android:textSize="18sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnAddAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="➕ إضافة جهاز جديد"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- قسم إضافة جهاز جديد -->
        <!-- ================================================= -->
        <LinearLayout
            android:id="@+id/addSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="➕ إضافة جهاز جديد"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔗 رابط السيرفر وكود الاقتران:"
                android:textColor="#90CAF9"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/addServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="wss://..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#4CAF50"
                android:inputType="textUri"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/addPairCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pair Code"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#4CAF50"
                android:inputType="text"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnRefreshDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 اتصال وتحديث الأجهزة"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvAddStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ اضغط '🔄 اتصال وتحديث الأجهزة'"
                android:textColor="#FFC107"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 اختر الجهاز:"
                android:textColor="#90CAF9"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#4CAF50"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/addDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اسم مخصص (مثلاً: موبايلي)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#4CAF50"
                android:inputType="text"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/addDevicePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="الباسورد"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#4CAF50"
                android:inputType="textPassword"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSaveAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 حفظ الحساب"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnCancelAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="إلغاء"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>