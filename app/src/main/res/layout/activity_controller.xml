<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="horizontal"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnMenu"
                android:text="☰"
                android:textSize="24sp"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:text="Remote"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatus"
                android:text="● غير متصل"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:background="#121212">

                <LinearLayout
                    android:id="@+id/mainContent"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- الاتصال -->
                    <EditText
                        android:id="@+id/controllerServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ws://192.168.1.10:8080"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:backgroundTint="#4CAF50"
                        android:inputType="textUri"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/controllerPairCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Pair Code"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/controllerConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="اتصال"
                        android:textSize="18sp"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <!-- إدارة الجهاز -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionDeviceManagement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="📱 إدارة الجهاز المحدد"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"/>

                            <Button
                                android:id="@+id/btnDeviceSettings"
                                android:text="⚙️ تغيير اسم وباسورد الجهاز"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:layout_marginBottom="8dp"/>

                            <Button
                                android:id="@+id/btnOpenWhatsApp"
                                android:text="💬 فتح WhatsApp على الجهاز"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- الشاشة -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionScreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="🖥️ الشاشة البعيدة"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="400dp"
                                android:background="#000000">

                                <ImageView
                                    android:id="@+id/remoteScreen"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#000000"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="Remote Screen" />

                                <TextureView
                                    android:id="@+id/cameraVideoView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp">

                                <Button
                                    android:id="@+id/btnStartScreen"
                                    android:text="▶ بدء البث"
                                    android:backgroundTint="#4CAF50"
                                    android:textColor="#FFFFFF"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp" />

                                <Button
                                    android:id="@+id/btnStopScreen"
                                    android:text="⏹ إيقاف"
                                    android:backgroundTint="#F44336"
                                    android:textColor="#FFFFFF"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- التحكم -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="🎮 التحكم"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <Button
                                    android:id="@+id/btnBack"
                                    android:text="◀ رجوع"
                                    android:backgroundTint="#2196F3"
                                    android:textColor="#FFFFFF"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp" />

                                <Button
                                    android:id="@+id/btnHome"
                                    android:text="⌂ رئيسية"
                                    android:backgroundTint="#2196F3"
                                    android:textColor="#FFFFFF"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="4dp" />

                                <Button
                                    android:id="@+id/btnRecents"
                                    android:text="▦ تطبيقات"
                                    android:backgroundTint="#2196F3"
                                    android:textColor="#FFFFFF"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Camera -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionCamera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="📷 الكاميرا والميكروفون"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <Button
                                    android:id="@+id/btnCameraStartBack"
                                    android:text="▶ خلفية"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"/>

                                <Button
                                    android:id="@+id/btnCameraStartFront"
                                    android:text="▶ أمامية"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"/>

                                <Button
                                    android:id="@+id/btnCameraStop"
                                    android:text="⏹ إيقاف"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"/>

                                <Button
                                    android:id="@+id/btnCameraSwitch"
                                    android:text="🔄 تبديل"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <Button
                                    android:id="@+id/btnMicStart"
                                    android:text="🎙 تشغيل المايك"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"/>

                                <Button
                                    android:id="@+id/btnMicStop"
                                    android:text="⏹ إيقاف المايك"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Device Info -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="📊 معلومات الجهاز"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnDeviceInfo"
                                android:text="📱 معلومات الجهاز"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnBattery"
                                android:text="🔋 البطارية"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnNetwork"
                                android:text="📶 الشبكة"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Apps -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="📦 التطبيقات"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnApps"
                                android:text="📥 جلب التطبيقات"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Calls -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionCalls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="📞 المكالمات"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <Button
                                    android:id="@+id/btnCalls"
                                    android:text="📥 سجل المكالمات"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"/>

                                <Button
                                    android:id="@+id/btnDial"
                                    android:text="📞 فتح الاتصال"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- SMS -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionSms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="💬 الرسائل"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <Button
                                    android:id="@+id/btnSms"
                                    android:text="📥 جلب الرسائل"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"/>

                                <Button
                                    android:id="@+id/btnSendSms"
                                    android:text="✉ إرسال رسالة"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Browser -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionBrowser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="🌐 التصفح"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <EditText
                                android:id="@+id/browserUrl"
                                android:hint="https://example.com"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#888888"
                                android:inputType="textUri"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>

                            <Button
                                android:id="@+id/btnOpenUrl"
                                android:text="🌐 فتح الرابط على الهاتف"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Files -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionFiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="📁 الملفات"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnFiles"
                                android:text="📥 تصفح الملفات"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Notifications -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="🔔 الإشعارات"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnNotifications"
                                android:text="ℹ️ حالة الإشعارات"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Security -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sectionSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="🔒 الأمان"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnLockDevice"
                                android:text="🔒 قفل الجهاز"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                            <Button
                                android:id="@+id/btnAlarm"
                                android:text="🚨 تشغيل الإنذار"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- القائمة الجانبية -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1A1A"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:background="#2196F3"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Remote"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="لوحة التحكم"
                    android:textColor="#E3F2FD"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- الأجهزة -->
                    <TextView
                        android:id="@+id/tvDevicesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 الأجهزة"
                        android:textColor="#90CAF9"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/deviceListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="12dp" />

                    <!-- باقي القائمة -->
                    <TextView android:id="@+id/navConnection" android:text="🔗 الاتصال" android:textColor="#FFFFFF" android:textSize="16sp" android:padding="16dp" android:background="?attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/navScreen" android:text="🖥️ الشاشة" android:textColor="#FFFFFF" android:textSize="16sp" android:padding="16dp" android:background="?attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/navCamera" android:text="📷 الكاميرا" android:textColor="#FFFFFF" android:textSize="16sp" android:padding="16dp" android:background="?attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/navInfo" android:text="📊 المعلومات" android:textColor="#FFFFFF" android:textSize="16sp" android:padding="16dp" android:background="?attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="wrap_content" />

